import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
    output wire9: ignition_wire();
    output wire10: ignition_wire();
}

private node lambo_v10_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 46.0 * units.cc;
    input intake_runner_volume: 110.0 * units.cc;
    input intake_runner_cross_section_area: 1.8 * units.inch * 1.8 * units.inch;
    input exhaust_runner_volume: 40.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.5 * units.inch * 1.5 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 45 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 110 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 175 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 235 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 280 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 315 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 340 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 355 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 362 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 38 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 95 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 150 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 200 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 238 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 265 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 282 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 292 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 298 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

private node lambo_v10_camshaft {
    input intake_lobe_profile;
    input exhaust_lobe_profile;
    input lobe_separation: 114 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 0.6 * units.inch;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;
    output intake_cam_1: _intake_cam_1;
    output exhaust_cam_1: _exhaust_cam_1;

    camshaft_parameters params (
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile)

    label rot(72 * units.deg)
    label rot360(360 * units.deg)

    // Firing order: 1-6-5-10-2-7-3-8-4-9
    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * rot) // 1
        .add_lobe(rot360 - exhaust_lobe_center + 4 * rot) // 2
        .add_lobe(rot360 - exhaust_lobe_center + 6 * rot) // 3
        .add_lobe(rot360 - exhaust_lobe_center + 8 * rot) // 4
        .add_lobe(rot360 - exhaust_lobe_center + 2 * rot) // 5
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * rot) // 1
        .add_lobe(rot360 + intake_lobe_center + 4 * rot) // 2
        .add_lobe(rot360 + intake_lobe_center + 6 * rot) // 3
        .add_lobe(rot360 + intake_lobe_center + 8 * rot) // 4
        .add_lobe(rot360 + intake_lobe_center + 2 * rot) // 5

    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + 1 * rot) // 6
        .add_lobe(rot360 - exhaust_lobe_center + 5 * rot) // 7
        .add_lobe(rot360 - exhaust_lobe_center + 7 * rot) // 8
        .add_lobe(rot360 - exhaust_lobe_center + 9 * rot) // 9
        .add_lobe(rot360 - exhaust_lobe_center + 3 * rot) // 10
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + 1 * rot) // 6
        .add_lobe(rot360 + intake_lobe_center + 5 * rot) // 7
        .add_lobe(rot360 + intake_lobe_center + 7 * rot) // 8
        .add_lobe(rot360 + intake_lobe_center + 9 * rot) // 9
        .add_lobe(rot360 + intake_lobe_center + 3 * rot) // 10
}

public node lamborghini_v10_5_2l {
    alias output __out: engine;

    wires wires()

    engine engine(
        name: "Lamborghini 5.2L DOHC V10",
        starter_torque: 160 * units.lb_ft,
        starter_speed: 250 * units.rpm,
        redline: 8800 * units.rpm,
        throttle_gamma: 2.0,
        fuel: fuel(
            max_burning_efficiency: 0.98
        ),
        hf_gain: 0.015,
        jitter: 0.4,
        noise: 0.1
    )

    label stroke(92.8 * units.mm)
    label bore(84.5 * units.mm)
    label rod_length(154.0 * units.mm)
    label compression_height(30.2 * units.mm)
    label crank_mass(44 * units.lb)
    label rod_mass(460 * units.g)
    label piston_mass(370 * units.g)
    label flywheel_mass(18 * units.lb)

    label v_angle(90 * units.deg)

    crankshaft c0(
        throw: stroke / 2.0,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 8.0 * units.lb_ft,
        moment_of_inertia: 0.12,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg + (v_angle / 2.0)
    )

    // 18-deg split-pin crankshaft on 90-deg V10 (Even-fire 72 deg)
    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 342 * units.deg)
    rod_journal rj2(angle: 288 * units.deg)
    rod_journal rj3(angle: 270 * units.deg)
    rod_journal rj4(angle: 72 * units.deg)
    rod_journal rj5(angle: 54 * units.deg)
    rod_journal rj6(angle: 216 * units.deg)
    rod_journal rj7(angle: 198 * units.deg)
    rod_journal rj8(angle: 144 * units.deg)
    rod_journal rj9(angle: 126 * units.deg)

    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)
        .add_rod_journal(rj6)
        .add_rod_journal(rj7)
        .add_rod_journal(rj8)
        .add_rod_journal(rj9)

    piston_parameters piston_params(
        mass: piston_mass,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 3.0 * units.L,
        plenum_cross_section_area: 36.0 * units.cm2,
        intake_flow_rate: k_carb(1300.0),
        runner_flow_rate: k_carb(480.0),
        runner_length: 5.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.998,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1500.0),
        primary_tube_length: 24.0 * units.inch,
        primary_flow_rate: k_carb(650.0),
        velocity_decay: 0.9
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 4.0,
        length: 70 * units.inch,
        impulse_response: ir_lib.default_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 4.0,
        length: 73 * units.inch,
        impulse_response: ir_lib.default_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2.0 + rod_length + compression_height
    )

    label spacing(3.6 * units.inch)

    cylinder_bank b0(bank_params, angle: v_angle / 2.0)
    cylinder_bank b1(bank_params, angle: -v_angle / 2.0)

    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: 4 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            primary_length: 3 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            primary_length: 2 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj6,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            primary_length: 1 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj8,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            primary_length: 0 * spacing
        )

    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            primary_length: 4 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire7,
            primary_length: 3 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire8,
            primary_length: 2 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj7,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire9,
            primary_length: 1 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.05)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj9,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire10,
            primary_length: 0 * spacing
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 240 * units.deg,
        gamma: 1.1,
        lift: 440 * units.thou,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 248 * units.deg,
        gamma: 1.1,
        lift: 440 * units.thou,
        steps: 100
    )

    lambo_v10_camshaft camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        lobe_separation: 114 * units.deg,
        base_radius: 0.6 * units.inch
    )

    b0.set_cylinder_head(
        lambo_v10_head(
            intake_camshaft: camshaft.intake_cam_0,
            exhaust_camshaft: camshaft.exhaust_cam_0,
            flip_display: false
        )
    )
    b1.set_cylinder_head(
        lambo_v10_head(
            intake_camshaft: camshaft.intake_cam_1,
            exhaust_camshaft: camshaft.exhaust_cam_1,
            flip_display: true
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 16 * units.deg)
        .add_sample(1000 * units.rpm, 16 * units.deg)
        .add_sample(2000 * units.rpm, 24 * units.deg)
        .add_sample(3000 * units.rpm, 32 * units.deg)
        .add_sample(4000 * units.rpm, 36 * units.deg)
        .add_sample(5000 * units.rpm, 38 * units.deg)
        .add_sample(6000 * units.rpm, 40 * units.deg)
        .add_sample(7000 * units.rpm, 40 * units.deg)
        .add_sample(8000 * units.rpm, 40 * units.deg)
        .add_sample(9000 * units.rpm, 40 * units.deg)

    ignition_module ignition(
        timing_curve: timing_curve,
        rev_limit: 8800 * units.rpm,
        limiter_duration: 0.05
    )
    ignition
        .connect_wire(wires.wire1, (0.0 / 10.0) * cycle)
        .connect_wire(wires.wire6, (1.0 / 10.0) * cycle)
        .connect_wire(wires.wire5, (2.0 / 10.0) * cycle)
        .connect_wire(wires.wire10, (3.0 / 10.0) * cycle)
        .connect_wire(wires.wire2, (4.0 / 10.0) * cycle)
        .connect_wire(wires.wire7, (5.0 / 10.0) * cycle)
        .connect_wire(wires.wire3, (6.0 / 10.0) * cycle)
        .connect_wire(wires.wire8, (7.0 / 10.0) * cycle)
        .connect_wire(wires.wire4, (8.0 / 10.0) * cycle)
        .connect_wire(wires.wire9, (9.0 / 10.0) * cycle)

    engine.add_ignition_module(ignition)
}

public node main {
    set_engine(lamborghini_v10_5_2l())
}
