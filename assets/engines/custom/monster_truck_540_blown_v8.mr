import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
}

private node monster_540_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 118.0 * units.cc;
    input intake_runner_volume: 240.0 * units.cc;
    input intake_runner_cross_section_area: 2.5 * units.inch * 2.5 * units.inch;
    input exhaust_runner_volume: 95.0 * units.cc;
    input exhaust_runner_cross_section_area: 2.2 * units.inch * 2.2 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 40 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 100 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 170 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 240 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 300 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 350 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 390 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 420 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 440 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 450 * flow_attenuation)
        .add_flow_sample(550 * lift_scale, 455 * flow_attenuation)
        .add_flow_sample(600 * lift_scale, 458 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 35 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 85 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 145 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 205 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 255 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 295 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 320 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 340 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 352 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 358 * flow_attenuation)
        .add_flow_sample(550 * lift_scale, 362 * flow_attenuation)
        .add_flow_sample(600 * lift_scale, 364 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

private node monster_540_camshaft {
    input intake_lobe_profile;
    input exhaust_lobe_profile;
    input lobe_separation: 114 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 0.75 * units.inch;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;
    output intake_cam_1: _intake_cam_1;
    output exhaust_cam_1: _exhaust_cam_1;

    camshaft_parameters params (
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile)

    label rot(90 * units.deg)
    label rot360(360 * units.deg)

    // Firing order: 1-8-4-3-6-5-7-2
    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * rot) // 1
        .add_lobe(rot360 - exhaust_lobe_center + 3 * rot) // 3
        .add_lobe(rot360 - exhaust_lobe_center + 5 * rot) // 5
        .add_lobe(rot360 - exhaust_lobe_center + 6 * rot) // 7
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * rot) // 1
        .add_lobe(rot360 + intake_lobe_center + 3 * rot) // 3
        .add_lobe(rot360 + intake_lobe_center + 5 * rot) // 5
        .add_lobe(rot360 + intake_lobe_center + 6 * rot) // 7

    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + 7 * rot) // 2
        .add_lobe(rot360 - exhaust_lobe_center + 2 * rot) // 4
        .add_lobe(rot360 - exhaust_lobe_center + 4 * rot) // 6
        .add_lobe(rot360 - exhaust_lobe_center + 1 * rot) // 8
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + 7 * rot) // 2
        .add_lobe(rot360 + intake_lobe_center + 2 * rot) // 4
        .add_lobe(rot360 + intake_lobe_center + 4 * rot) // 6
        .add_lobe(rot360 + intake_lobe_center + 1 * rot) // 8
}

public node monster_truck_540_blown_v8 {
    alias output __out: engine;

    wires wires()

    engine engine(
        name: "540ci Supercharged Monster Truck V8",
        starter_torque: 350 * units.lb_ft,
        starter_speed: 400 * units.rpm,
        redline: 6500 * units.rpm,
        throttle_gamma: 1.8,
        fuel: fuel(
            max_burning_efficiency: 0.96
        ),
        hf_gain: 0.012,
        jitter: 0.35,
        noise: 0.15
    )

    label stroke(4.250 * units.inch)
    label bore(4.500 * units.inch)
    label rod_length(6.385 * units.inch)
    label compression_height(1.270 * units.inch)
    label crank_mass(70 * units.lb)
    label rod_mass(780 * units.g)
    label piston_mass(640 * units.g)
    label flywheel_mass(26 * units.lb)

    label v_angle(90 * units.deg)

    crankshaft c0(
        throw: stroke / 2.0,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 8.0 * units.lb_ft,
        moment_of_inertia: 0.18,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg - (v_angle / 2.0)
    )

    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 270 * units.deg)
    rod_journal rj2(angle: 90 * units.deg)
    rod_journal rj3(angle: 180 * units.deg)

    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: piston_mass,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 4.0 * units.L,
        plenum_cross_section_area: 45.0 * units.cm2,
        intake_flow_rate: k_carb(1500.0),
        runner_flow_rate: k_carb(550.0),
        runner_length: 6.0 * units.inch,
        idle_flow_rate: k_carb(0.004),
        idle_throttle_plate_position: 0.997,
        velocity_decay: 0.5
    )

    // Deep thunderous competition headers
    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1600.0),
        primary_tube_length: 28.0 * units.inch,
        primary_flow_rate: k_carb(700.0),
        velocity_decay: 0.85
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 3.8,
        length: 65 * units.inch,
        impulse_response: ir_lib.default_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 3.8,
        length: 68 * units.inch,
        impulse_response: ir_lib.default_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2.0 + rod_length + compression_height
    )

    label spacing(4.84 * units.inch)

    cylinder_bank b0(bank_params, angle: -v_angle / 2.0)
    cylinder_bank b1(bank_params, angle: v_angle / 2.0)

    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.02)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: 3 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.02)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            primary_length: 2 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.02)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            primary_length: 1 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.02)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire7,
            primary_length: 0 * spacing
        )

    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.02)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            primary_length: 3 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.02)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            primary_length: 2 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.02)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            primary_length: 1 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.02)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire8,
            primary_length: 0 * spacing
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 248 * units.deg,
        gamma: 1.15,
        lift: 620 * units.thou,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 254 * units.deg,
        gamma: 1.15,
        lift: 620 * units.thou,
        steps: 100
    )

    monster_540_camshaft camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        lobe_separation: 114 * units.deg,
        base_radius: 0.75 * units.inch
    )

    b0.set_cylinder_head(
        monster_540_head(
            intake_camshaft: camshaft.intake_cam_0,
            exhaust_camshaft: camshaft.exhaust_cam_0,
            flip_display: false
        )
    )
    b1.set_cylinder_head(
        monster_540_head(
            intake_camshaft: camshaft.intake_cam_1,
            exhaust_camshaft: camshaft.exhaust_cam_1,
            flip_display: true
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 16 * units.deg)
        .add_sample(1000 * units.rpm, 16 * units.deg)
        .add_sample(2000 * units.rpm, 24 * units.deg)
        .add_sample(3000 * units.rpm, 30 * units.deg)
        .add_sample(4000 * units.rpm, 32 * units.deg)
        .add_sample(5000 * units.rpm, 32 * units.deg)
        .add_sample(6000 * units.rpm, 32 * units.deg)
        .add_sample(7000 * units.rpm, 32 * units.deg)

    ignition_module ignition(
        timing_curve: timing_curve,
        rev_limit: 6500 * units.rpm,
        limiter_duration: 0.05
    )
    ignition
        .connect_wire(wires.wire1, (0.0 / 8.0) * cycle)
        .connect_wire(wires.wire8, (1.0 / 8.0) * cycle)
        .connect_wire(wires.wire4, (2.0 / 8.0) * cycle)
        .connect_wire(wires.wire3, (3.0 / 8.0) * cycle)
        .connect_wire(wires.wire6, (4.0 / 8.0) * cycle)
        .connect_wire(wires.wire5, (5.0 / 8.0) * cycle)
        .connect_wire(wires.wire7, (6.0 / 8.0) * cycle)
        .connect_wire(wires.wire2, (7.0 / 8.0) * cycle)

    engine.add_ignition_module(ignition)
}

public node main {
    set_engine(monster_truck_540_blown_v8())
}
