import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
    output wire9: ignition_wire();
    output wire10: ignition_wire();
}

private node viper_v10_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume: 78.0 * units.cc;
    input intake_runner_volume: 200.0 * units.cc;
    input intake_runner_cross_section_area: 2.2 * units.inch * 2.2 * units.inch;
    input exhaust_runner_volume: 80.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.9 * units.inch * 1.9 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 40 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 95 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 160 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 225 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 275 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 315 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 345 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 362 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 372 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 378 * flow_attenuation)
        .add_flow_sample(550 * lift_scale, 380 * flow_attenuation)
        .add_flow_sample(600 * lift_scale, 380 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 32 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 80 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 135 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 185 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 228 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 258 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 278 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 290 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 298 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 302 * flow_attenuation)
        .add_flow_sample(550 * lift_scale, 305 * flow_attenuation)
        .add_flow_sample(600 * lift_scale, 305 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

private node viper_v10_camshaft {
    input intake_lobe_profile;
    input exhaust_lobe_profile;
    input lobe_separation: 117 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 0.75 * units.inch;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;
    output intake_cam_1: _intake_cam_1;
    output exhaust_cam_1: _exhaust_cam_1;

    camshaft_parameters params (
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile)

    label rot360(360 * units.deg)

    // Firing order: 1-10-9-4-3-6-5-8-7-2
    // Firing times in degrees: 1 (0°), 10 (54°), 9 (144°), 4 (198°), 3 (288°), 6 (342°), 5 (432°), 8 (486°), 7 (576°), 2 (630°)
    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * units.deg)   // 1
        .add_lobe(rot360 - exhaust_lobe_center + 288 * units.deg) // 3
        .add_lobe(rot360 - exhaust_lobe_center + 432 * units.deg) // 5
        .add_lobe(rot360 - exhaust_lobe_center + 576 * units.deg) // 7
        .add_lobe(rot360 - exhaust_lobe_center + 144 * units.deg) // 9
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * units.deg)   // 1
        .add_lobe(rot360 + intake_lobe_center + 288 * units.deg) // 3
        .add_lobe(rot360 + intake_lobe_center + 432 * units.deg) // 5
        .add_lobe(rot360 + intake_lobe_center + 576 * units.deg) // 7
        .add_lobe(rot360 + intake_lobe_center + 144 * units.deg) // 9

    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + 630 * units.deg) // 2
        .add_lobe(rot360 - exhaust_lobe_center + 198 * units.deg) // 4
        .add_lobe(rot360 - exhaust_lobe_center + 342 * units.deg) // 6
        .add_lobe(rot360 - exhaust_lobe_center + 486 * units.deg) // 8
        .add_lobe(rot360 - exhaust_lobe_center + 54 * units.deg)  // 10
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + 630 * units.deg) // 2
        .add_lobe(rot360 + intake_lobe_center + 198 * units.deg) // 4
        .add_lobe(rot360 + intake_lobe_center + 342 * units.deg) // 6
        .add_lobe(rot360 + intake_lobe_center + 486 * units.deg) // 8
        .add_lobe(rot360 + intake_lobe_center + 54 * units.deg)  // 10
}

public node dodge_viper_v10_8_4l {
    alias output __out: engine;

    wires wires()

    engine engine(
        name: "Dodge Viper 8.4L VX I V10",
        starter_torque: 260 * units.lb_ft,
        starter_speed: 250 * units.rpm,
        redline: 6600 * units.rpm,
        throttle_gamma: 1.8,
        fuel: fuel(
            max_burning_efficiency: 0.95
        ),
        hf_gain: 0.018,
        jitter: 0.5,
        noise: 0.2
    )

    label stroke(100.6 * units.mm)
    label bore(103.0 * units.mm)
    label rod_length(158.5 * units.mm)
    label compression_height(33.0 * units.mm)
    label crank_mass(68 * units.lb)
    label rod_mass(710 * units.g)
    label piston_mass(580 * units.g)
    label flywheel_mass(28 * units.lb)

    label v_angle(90 * units.deg)

    crankshaft c0(
        throw: stroke / 2.0,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 14.0 * units.lb_ft,
        moment_of_inertia: 0.22,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg - (v_angle / 2.0)
    )

    // Dodge Viper 90-deg V10 Shared Journals
    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 288 * units.deg)
    rod_journal rj2(angle: 72 * units.deg)
    rod_journal rj3(angle: 216 * units.deg)
    rod_journal rj4(angle: 144 * units.deg)

    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)

    piston_parameters piston_params(
        mass: piston_mass,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 3.5 * units.L,
        plenum_cross_section_area: 40.0 * units.cm2,
        intake_flow_rate: k_carb(1300.0),
        runner_flow_rate: k_carb(500.0),
        runner_length: 7.0 * units.inch,
        idle_flow_rate: k_carb(0.004),
        idle_throttle_plate_position: 0.996,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1400.0),
        primary_tube_length: 32.0 * units.inch,
        primary_flow_rate: k_carb(650.0),
        velocity_decay: 0.8
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 4.0,
        length: 95 * units.inch,
        impulse_response: ir_lib.default_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 4.0,
        length: 98 * units.inch,
        impulse_response: ir_lib.default_0
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2.0 + rod_length + compression_height
    )

    label spacing(4.4 * units.inch)

    cylinder_bank b0(bank_params, angle: -v_angle / 2.0)
    cylinder_bank b1(bank_params, angle: v_angle / 2.0)

    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: 4 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            primary_length: 3 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            primary_length: 2 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire7,
            primary_length: 1 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire9,
            primary_length: 0 * spacing
        )

    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            primary_length: 4 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            primary_length: 3 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            primary_length: 2 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire8,
            primary_length: 1 * spacing
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.08)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire10,
            primary_length: 0 * spacing
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 226 * units.deg,
        gamma: 1.0,
        lift: 584 * units.thou,
        steps: 100
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 238 * units.deg,
        gamma: 1.0,
        lift: 584 * units.thou,
        steps: 100
    )

    viper_v10_camshaft camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        lobe_separation: 117 * units.deg,
        base_radius: 0.75 * units.inch
    )

    b0.set_cylinder_head(
        viper_v10_head(
            intake_camshaft: camshaft.intake_cam_0,
            exhaust_camshaft: camshaft.exhaust_cam_0,
            flip_display: false
        )
    )
    b1.set_cylinder_head(
        viper_v10_head(
            intake_camshaft: camshaft.intake_cam_1,
            exhaust_camshaft: camshaft.exhaust_cam_1,
            flip_display: true
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 16 * units.deg)
        .add_sample(1000 * units.rpm, 16 * units.deg)
        .add_sample(2000 * units.rpm, 24 * units.deg)
        .add_sample(3000 * units.rpm, 32 * units.deg)
        .add_sample(4000 * units.rpm, 35 * units.deg)
        .add_sample(5000 * units.rpm, 36 * units.deg)
        .add_sample(6000 * units.rpm, 36 * units.deg)
        .add_sample(7000 * units.rpm, 36 * units.deg)

    ignition_module ignition(
        timing_curve: timing_curve,
        rev_limit: 6600 * units.rpm,
        limiter_duration: 0.06
    )
    // Firing times in 720-deg cycle: 1 (0°), 10 (54°), 9 (144°), 4 (198°), 3 (288°), 6 (342°), 5 (432°), 8 (486°), 7 (576°), 2 (630°)
    ignition
        .connect_wire(wires.wire1, (0.0 / 720.0) * cycle)
        .connect_wire(wires.wire10, (54.0 / 720.0) * cycle)
        .connect_wire(wires.wire9, (144.0 / 720.0) * cycle)
        .connect_wire(wires.wire4, (198.0 / 720.0) * cycle)
        .connect_wire(wires.wire3, (288.0 / 720.0) * cycle)
        .connect_wire(wires.wire6, (342.0 / 720.0) * cycle)
        .connect_wire(wires.wire5, (432.0 / 720.0) * cycle)
        .connect_wire(wires.wire8, (486.0 / 720.0) * cycle)
        .connect_wire(wires.wire7, (576.0 / 720.0) * cycle)
        .connect_wire(wires.wire2, (630.0 / 720.0) * cycle)

    engine.add_ignition_module(ignition)
}

public node main {
    set_engine(dodge_viper_v10_8_4l())
}
